# Claude Code Testing Environment Configuration
# Copy this file to .env and fill in your values
# Note: .env is gitignored and will not be committed

# ==============================================================================
# TEST CONFIGURATION
# ==============================================================================

# Test data directory location
TEST_DATA_DIR=/tmp/test-data

# Skip container tests if no runtime available
SKIP_CONTAINER_TESTS=true

# Use application-level logging instead of packet capture
USE_APP_LEVEL_LOGGING=true

# Session timeout (seconds)
SESSION_TIMEOUT=1800

# ==============================================================================
# API KEYS (Optional - for external service tests)
# ==============================================================================

# Anthropic API key (if testing Claude API integration)
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token (for advanced git operations)
# GITHUB_TOKEN=ghp_...

# OpenAI API key (if testing comparison features)
# OPENAI_API_KEY=sk-...

# ==============================================================================
# DATABASE CONFIGURATION (Optional - if testing DB integration)
# ==============================================================================

# PostgreSQL connection
# DATABASE_URL=postgresql://user:password@localhost:5432/testdb

# Redis connection
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log output directory
LOG_DIR=./logs

# JSONL log file pattern
LOG_FILE_PATTERN=log_{timestamp}.jsonl

# ==============================================================================
# TESTING BEHAVIOR
# ==============================================================================

# Enable verbose test output
VERBOSE_TESTS=false

# Stop on first test failure
FAIL_FAST=false

# Generate detailed test reports
GENERATE_REPORTS=true

# ==============================================================================
# ENVIRONMENT CAPABILITIES (Auto-detected by setup script)
# ==============================================================================

# These values are typically auto-detected but can be overridden

# Container runtime (podman, docker, or none)
# CONTAINER_RUNTIME=none

# Network monitoring tool (tcpdump, tshark, scapy, or app-level)
# NETWORK_MONITOR=app-level

# Python version
# PYTHON_VERSION=3.9

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable performance benchmarking
ENABLE_BENCHMARKS=true

# Enable memory profiling
ENABLE_PROFILING=false

# ==============================================================================
# NOTIFICATION SETTINGS (Optional)
# ==============================================================================

# Slack webhook for test completion notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email for notifications
# NOTIFICATION_EMAIL=user@example.com

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in required values (most are optional)
# 3. Run setup script: ./setup_environment.sh
# 4. The .env file will be ignored by git
# 5. See CLAUDE.md for more information
